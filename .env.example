# Controle dos PJs — pj.camim.com.br
# Copie para .env e preencha. O .env NUNCA vai para o git.

SECRET_KEY=troque-por-uma-chave-longa-aleatoria
DEBUG=false
ALLOWED_HOSTS=pj.camim.com.br,localhost,127.0.0.1

# Login único Camim (idCamim) — painel https://idcamim.camim.com.br
IDCAMIM_CLIENT_ID=
IDCAMIM_CLIENT_SECRET=
IDCAMIM_DISCOVERY_URL=https://idcamim.camim.com.br/.well-known/openid-configuration
IDCAMIM_REDIRECT_URI=https://pj.camim.com.br/auth/callback

# E-mail — Gmail do Cristiano (app password, mesma do robô PJ do relatorio_h_t)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_HOST_USER=cristiano@camim.com.br
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Cristiano Camim <cristiano@camim.com.br>
EMAIL_PAGADOR=equipe@camim.com.br
EMAIL_ADMIN=cristiano@camim.com.br
# true = TODO e-mail sai só para EMAIL_ADMIN (modo de teste seguro)
EMAIL_MODO_TESTE=true

# IA — Groq (chave "kpis", a mesma do relatorio_h_t de produção)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
