# systemd — /etc/systemd/system/pj.service
# sudo systemctl daemon-reload && sudo systemctl enable --now pj
[Unit]
Description=Controle dos PJs (pj.camim.com.br)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/pj
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/opt/pj
ExecStart=/opt/pj/.venv/bin/gunicorn pj.wsgi:application \
  --bind 127.0.0.1:8022 --workers 3 --timeout 120 --graceful-timeout 30
# Deploy SEM derrubar ninguém: `systemctl reload pj` (HUP) troca os workers
# um a um, terminando as requisições em andamento. `restart` só quando
# mudar o próprio unit/venv.
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

# Endurecimento
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/pj

[Install]
WantedBy=multi-user.target
